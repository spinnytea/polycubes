{
  "name": "polycubes",
  "version": "9.4.0",
  "description": "Enumerating polycubes",
  "main": "index.js",
  "scripts": {
    "prof": "node --cpu-prof index.js -vvv enumerate",
    "start": "node index.js",
    "fix": "npm run lint && npm run format",
    "lint": "eslint . --fix",
    "format": "prettier --write --list-different .",
    "test": "vitest -u all",
    "test:cov": "vitest run --coverage",
    "gen:task-labels": "node scripts/find-task-labels.mjs",
    "prerelease": "npm run lint && npm run gen:task-labels && npm run format && npm run test:cov",
    "release": "git prune & npm prune"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinnytea/polycubes.git"
  },
  "author": "spinnytea",
  "bugs": {
    "url": "https://github.com/spinnytea/polycubes/issues"
  },
  "homepage": "https://github.com/spinnytea/polycubes#readme",
  "dependencies": {
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
